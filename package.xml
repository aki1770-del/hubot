<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hubot</name>
  <version>0.1.0</version>
  <description>
    A method to bridge a robot and a human, from the perspective of the move. A move
    is mobility: something starts at A and arrives at B, and between A and B there is
    always an obstacle. To avoid collision and to make the journey a better one, hubot
    offers the human a suggestion before the actual risk arrives. First component: a
    nav2 costmap filter that applies limits inside mapped zones and tells a person, in
    words, while a limit is still only requested and not yet in force.
  </description>
  <maintainer email="aki1770@gmail.com">Komada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ⚑ NOT VERIFIED, marked 2026-09-06 (CPP, G1 limb 4).
       `<depend>nav2_costmap_2d</depend>` below carries NO version bound, which
       reads as a claim of compatibility with every nav2_costmap_2d. It is not one.
       Measured 2026-09-06: this package does NOT compile against released nav2
       1.5.0 or 1.5.1 — src/zone_parameter_filter.cpp:119 needs
       nav2_costmap_2d::ZONE_PARAMETER_FILTER, which exists only on branches
       `main` and `lyrical`, in no release tag.
       ⚑ AND THE MANIFEST CANNOT EXPRESS THE REAL CONSTRAINT: version_gte/version_lt
       key on the version string, and tag 1.5.1 (a6354f3f) and lyrical HEAD
       (6f23b11c) BOTH declare 1.5.1 while only the second one works. So the bound
       is stated here in words rather than asserted in a field that would be wrong.
       Verified against: upstream lyrical HEAD 6f23b11c only. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/hubot_plugins.xml"/>
  </export>
</package>
