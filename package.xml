<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hubot</name>
  <version>0.1.1</version>
  <description>
    A nav2 costmap filter that applies speed and behaviour limits inside mapped zones and
    tells a person, in words, when a limit was requested and it is not yet known whether it
    took. First component of hubot, a method to bridge a robot and a human from the
    perspective of the move: A to B, an obstacle between, and the person keeping the
    decision. The suggestion arrives before the ENFORCEMENT OUTCOME is known; no lookahead
    is built, so it does not arrive before the hazard. Never run on a robot; QM-class.
  </description>
  <maintainer email="aki1770@gmail.com">Komada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ⚑ VERIFIED against a RELEASE, 2026-09-06 (CPP, Phase B).
       `<depend>nav2_costmap_2d</depend>` below carries no version bound. Earlier
       the same day that read as a false compatibility claim, because the source
       imported nav2_costmap_2d::ZONE_PARAMETER_FILTER, a symbol present on
       branches `main`/`lyrical` and in no release tag, and the package did not
       compile against 1.5.0 or 1.5.1. That import was a copying mistake: the
       value is a wire discriminator the integrator's own costmap_filter_info_server
       publishes, and this filter only has to agree with it. It is now
       hubot::kZoneParameterFilterType (include/hubot/zone_parameter_filter.hpp),
       cross-checked by static_assert against BINARY_FILTER+1 on every nav2 and
       against the upstream symbol wherever CMake finds it.
       Measured 2026-09-06: builds and installs against release tag 1.5.1 with the
       whole nav2 dependency chain built from that tag; the plugin resolves and
       runs through a live LayeredCostmap there. 1.5.0 was NOT built and is not
       claimed. The manifest still cannot express a version constraint honestly - -
       tag 1.5.1 and lyrical HEAD both declare 1.5.1 - - so none is asserted.
       Verified against: release tag 1.5.1 (a6354f3f) AND lyrical nightly. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_msgs</depend>
  <!-- ⚑ ADDED 2026-09-06 (CPP). Both were `find_package(... REQUIRED)` in
       CMakeLists.txt (:20, :21) and linked as exported targets (:36, :37, :62,
       :63) while appearing in NEITHER manifest: `grep -c nav2_util package.xml`
       and `grep -c nav2_ros_common package.xml` both returned 0. A stranger's
       `rosdep install` over this path therefore installed neither, and the first
       thing a stranger saw was a configure error naming a package this manifest
       never mentioned. The manifest must declare what the build file requires.
       (Written without a double hyphen on purpose: XML forbids one inside a
       comment, and the first draft of this note used the flag's real spelling
       and made package.xml unparseable.) -->
  <depend>nav2_util</depend>
  <depend>nav2_ros_common</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- ⚑ RUNTIME-ONLY, ADDED 2026-09-06 (CPP) alongside launch/, params/ and
       maps/. These are exec_depend and NOT depend on purpose: the filter
       library links none of them and building this package does not need them.
       They are what `ros2 launch hubot zone_filter_demo_launch.py` starts.
       An integrator who wants only the plugin .so on a target can take the
       build dependencies alone, with rosdep's from-paths and dependency-types
       flags (spelled without their leading double hyphens here, because XML
       forbids one inside a comment and the note 20 lines above this one says
       so: this draft made that exact mistake and package.xml would not parse):
           rosdep install [from-paths] src [dependency-types]=build
       Declaring them is the honest cost of shipping a bring-up that works;
       omitting them would have made the launch file fail on a stranger's
       machine with an error naming a package this manifest never mentioned,
       which is the exact defect corrected in nav2_util/nav2_ros_common above. -->
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- tf2_ros is deliberately NOT repeated here. It is already a full
       `depend` above (the test targets link tf2_ros::tf2_ros), and catkin_pkg
       rejects the pair outright: "The generic dependency on 'tf2_ros' is
       redundant with: exec_depend". That is a HARD manifest parse failure, not
       a warning, so the package does not configure. The launch file's two
       static_transform_publisher nodes come from that same `depend`. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/hubot_plugins.xml"/>
  </export>
</package>
